{
  "name": "playwrightbdd",
  "version": "1.0.0",
  "description": "Playwright framework using BDD",
  "main": "index.js",
  "scripts": {
    "cucumber": "tsx node_modules/@cucumber/cucumber/bin/cucumber.js",
    "report": "start reports/report.html",
    "video": "TVIDEO=1 npm run cucumber ",
    "smoke": "npm run cucumber -- --tags @smoke",
    "snippets": "npm run cucumber  features/**/*.feature --dry-run --format snippets",
    "allure": "allure serve reports/allure-results"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kashish09/playwrightBDD.git"
  },
  "keywords": [],
