  "type": "module",
  "bugs": {
    "url": "https://github.com/Kashish09/playwrightBDD/issues"
  },
  "homepage": "https://github.com/Kashish09/playwrightBDD#readme",
  "devDependencies": {
    "@cucumber/cucumber": "^12.5.0",
    "@cucumber/messages": "^31.1.0",
    "@playwright/test": "^1.57.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.0.3",
    "@types/winston": "^2.4.4",
    "allure-commandline": "^2.36.0",
    "allure-cucumberjs": "^3.4.3",
    "allure-js-commons": "^3.4.3",
    "dotenv": "^17.2.3",
    "fs-extra": "^11.3.3",
    "open": "^11.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "winston": "^3.19.0"
  }
}
